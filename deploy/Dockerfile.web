FROM node:24-bookworm-slim
ENV NODE_ENV=production APP_MODE=hosted PORT=3000 DATA_DIR=/app/data
WORKDIR /app
COPY --chown=node:node package.json server.mjs ./
COPY --chown=node:node site ./site
COPY --chown=node:node backend ./backend
COPY --chown=node:node tooling ./tooling
COPY --chown=node:node ProjectSettings/ProjectVersion.txt ./ProjectSettings/ProjectVersion.txt
COPY --chown=node:node Packages/manifest.json ./Packages/manifest.json
RUN mkdir -p /app/data && chown node:node /app/data && chmod 700 /app/data
USER node
EXPOSE 3000
CMD ["node", "server.mjs"]
