{
  "name": "gamedev-lab-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node tools/learning-site/server.mjs",
    "dev": "node tools/learning-site/server.mjs",
    "check": "npm --prefix tools/learning-site run check",
    "test": "npm --prefix tools/learning-site test",
    "test:editor": "npm --prefix tools/learning-site run test:editor",
    "test:hosted": "npm --prefix tools/learning-site run test:hosted",
    "test:learning": "npm --prefix tools/learning-site run test:learning"
  }
}
