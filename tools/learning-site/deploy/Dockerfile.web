FROM node:24-bookworm-slim
ENV NODE_ENV=production APP_MODE=hosted PORT=3000 DATA_DIR=/app/data
WORKDIR /app/tools/learning-site
COPY --chown=node:node tools/learning-site/package.json tools/learning-site/server.mjs ./
COPY --chown=node:node tools/learning-site/site ./site
COPY --chown=node:node tools/learning-site/backend ./backend
COPY --chown=node:node tools/learning-site/tooling ./tooling
COPY --chown=node:node unity/ProjectSettings/ProjectVersion.txt /app/unity/ProjectSettings/ProjectVersion.txt
COPY --chown=node:node unity/Packages/manifest.json /app/unity/Packages/manifest.json
RUN mkdir -p /app/data && chown node:node /app/data && chmod 700 /app/data
USER node
EXPOSE 3000
CMD ["node", "server.mjs"]
